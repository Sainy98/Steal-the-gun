# Optional for the Node server. The server reads real environment variables;
# for local .env loading use: node --env-file=.env server/index.mjs
PORT=3000
# Empty is correct when Render hosts the frontend and backend together.
ALLOWED_ORIGINS=
# Optional: a PERSISTENT disk path for recovering matches after process restarts.
# DATA_DIR=/var/data/bump-bandits
# Only the Vercel build uses BACKEND_URL. Replace with your real Render URL.
# BACKEND_URL=https://your-real-render-service.onrender.com
